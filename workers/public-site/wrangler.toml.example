name = "is-in-public-site"
main = "src/index.ts"
compatibility_date = "2026-06-02"

[observability]
enabled = true
head_sampling_rate = 1

[[kv_namespaces]]
binding = "KV"
id = "REPLACE_WITH_KV_NAMESPACE_ID"
preview_id = "REPLACE_WITH_KV_PREVIEW_ID"

[vars]
ROOT_DOMAIN = "example.com"
PRODUCT_NAME = "example.com"
WEB_REDIRECTS_ENABLED = "true"

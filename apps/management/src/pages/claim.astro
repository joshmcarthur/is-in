---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import { ROOT_DOMAIN } from "../siteDomain";
---
<Layout title="Claim your name">
  <a class="back-link" href="/">‹ Back</a>
  <div class="stack">
    <h2 class="h2">Claim your name</h2>
    <p class="lede">This will be your unique address on {ROOT_DOMAIN}.</p>
    <form id="form" class="stack" novalidate>
      <div class="input-suffix">
        <input
          id="subdomain"
          name="subdomain"
          autocomplete="off"
          spellcheck="false"
          autocapitalize="off"
          required
          aria-describedby="avail"
        />
        <span class="suffix" aria-hidden="true">.{ROOT_DOMAIN}</span>
      </div>
      <p id="capacity" class="muted" hidden></p>
      <p id="closed" class="status" role="status" hidden></p>
      <p id="sign-in-link" hidden>Already have a name? <a href="/sign-in">Sign in</a>.</p>
      <p id="avail" class="status" role="status" aria-live="polite"></p>
      <button type="submit" class="btn btn-primary" id="continue" disabled>Continue</button>
      <p id="guest-hint" class="lede" hidden></p>
    </form>
    <p id="msg" class="status" role="alert" hidden></p>
  </div>
  <script>
    import { apiBase } from "../client/apiBase";
    import { readJson, requiredElement } from "../client/dom";
    import { ROOT_DOMAIN } from "../siteDomain";

    const PENDING_SUB_KEY = "isin_pending_subdomain";

    type CapacityState = {
      signupsOpen?: boolean;
      signupsDisabled?: boolean;
      remaining?: number | null;
    };

    function formatCapacityLine(cap: CapacityState): string {
      if (cap.signupsDisabled) {
        return "Sign-ups are paused at the moment.";
      }
      if (cap.signupsOpen && cap.remaining !== null && cap.remaining !== undefined) {
        return `${cap.remaining} places left in this cohort.`;
      }
      return "This cohort is full. The next isn't open yet.";
    }

    function applyCapacityState(cap: CapacityState | null) {
      const capacityEl = document.getElementById("capacity");
      const closedEl = document.getElementById("closed");
      const signInLink = document.getElementById("sign-in-link");
      if (!capacityEl || !closedEl || !signInLink) return;

      if (!cap || cap.signupsOpen) {
        closedEl.hidden = true;
        signInLink.hidden = true;
        subdomainInput.disabled = false;
        if (cap?.signupsOpen && cap.remaining !== null && cap.remaining !== undefined) {
          capacityEl.textContent = formatCapacityLine(cap);
          capacityEl.hidden = false;
        } else {
          capacityEl.hidden = true;
        }
        return;
      }

      capacityEl.hidden = true;
      closedEl.hidden = false;
      closedEl.textContent = formatCapacityLine(cap);
      closedEl.className = "status";
      signInLink.hidden = false;
      subdomainInput.disabled = true;
      continueBtn.disabled = true;
      lastAvailableSubdomain = "";
      updateContinueLabel();
      updateGuestHint();
    }

    let capacityState: CapacityState | null = null;

    async function me() {
      const res = await fetch(`${apiBase}/api/v1/session/me`, { credentials: "include" });
      if (!res.ok) return null;
      return readJson<{ authenticated?: boolean }>(res);
    }

    async function hasSite() {
      const res = await fetch(`${apiBase}/api/v1/sites/me`, { credentials: "include" });
      if (!res.ok) return false;
      const body = await readJson<{ sites?: unknown[] }>(res);
      return Array.isArray(body.sites) && body.sites.length > 0;
    }

    const subdomainInput = requiredElement<HTMLInputElement>("subdomain");
    const avail = requiredElement("avail");
    const continueBtn = requiredElement<HTMLButtonElement>("continue");
    const form = requiredElement<HTMLFormElement>("form");
    const msg = requiredElement("msg");
    const guestHint = requiredElement("guest-hint");

    let checkTimer = 0;
    let checkSeq = 0;
    let authenticated = false;
    let lastAvailableSubdomain = "";

    function updateContinueLabel() {
      if (!authenticated && lastAvailableSubdomain) {
        continueBtn.textContent = "Sign in to reserve";
      } else {
        continueBtn.textContent = "Continue";
      }
    }

    function updateGuestHint() {
      if (authenticated || !lastAvailableSubdomain) {
        guestHint.hidden = true;
        guestHint.textContent = "";
        return;
      }
      guestHint.hidden = false;
      guestHint.textContent = `We'll email you a code, then bring you back to reserve ${lastAvailableSubdomain}.${ROOT_DOMAIN}.`;
    }

    function clearAvail() {
      avail.textContent = "";
      avail.className = "status";
      continueBtn.disabled = true;
      lastAvailableSubdomain = "";
      updateContinueLabel();
      updateGuestHint();
    }

    function setAvailSuccess(subdomain: string) {
      avail.textContent = `✓ ${subdomain}.${ROOT_DOMAIN} is available!`;
      avail.className = "status status--success";
      if (!subdomainInput.disabled) {
        continueBtn.disabled = false;
      }
      lastAvailableSubdomain = subdomain;
      updateContinueLabel();
      updateGuestHint();
    }

    function setAvailError(text: string) {
      avail.textContent = text;
      avail.className = "status status--error";
      continueBtn.disabled = true;
      lastAvailableSubdomain = "";
      updateContinueLabel();
      updateGuestHint();
    }

    function scheduleAvailabilityCheck(subdomain: string) {
      clearTimeout(checkTimer);
      if (!subdomain) {
        clearAvail();
        return;
      }
      continueBtn.disabled = true;
      lastAvailableSubdomain = "";
      updateContinueLabel();
      updateGuestHint();
      const seq = ++checkSeq;
      checkTimer = window.setTimeout(async () => {
        const res = await fetch(`${apiBase}/api/v1/availability`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ subdomain }),
        });
        if (seq !== checkSeq) return;
        const data = await readJson<{
          available?: boolean;
          reason?: string;
          subdomain?: string;
        }>(res);
        const name = typeof data.subdomain === "string" ? data.subdomain : subdomain;
        if (data.available) {
          setAvailSuccess(name);
          return;
        }
        if (data.reason === "invalid_or_reserved") {
          setAvailError("Use letters, numbers, and hyphens.");
          return;
        }
        setAvailError(`${name}.${ROOT_DOMAIN} is not available.`);
      }, 300);
    }

    subdomainInput.addEventListener("input", () => {
      scheduleAvailabilityCheck(subdomainInput.value.trim().toLowerCase());
    });

    function resolvePendingSubdomain() {
      const fromQuery = new URLSearchParams(window.location.search).get("subdomain");
      const fromStorage = sessionStorage.getItem(PENDING_SUB_KEY);
      const raw = (fromQuery ?? fromStorage ?? "").trim().toLowerCase();
      if (!raw) return "";
      sessionStorage.setItem(PENDING_SUB_KEY, raw);
      return raw;
    }

    (async () => {
      const capRes = await fetch(`${apiBase}/api/v1/platform/capacity`);
      if (capRes.ok) {
        capacityState = await readJson<CapacityState>(capRes);
        applyCapacityState(capacityState);
      }

      const u = await me();
      authenticated = !!(u && u.authenticated);
      if (authenticated && (await hasSite())) {
        window.location.href = "/dashboard";
        return;
      }
      updateContinueLabel();

      const pending = resolvePendingSubdomain();
      if (pending) {
        subdomainInput.value = pending;
        scheduleAvailabilityCheck(pending);
      }
    })();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (continueBtn.disabled) return;

      const subdomain = subdomainInput.value.trim().toLowerCase();

      if (!authenticated) {
        sessionStorage.setItem(PENDING_SUB_KEY, subdomain);
        window.location.href = "/sign-in";
        return;
      }

      continueBtn.disabled = true;
      continueBtn.textContent = "Reserving…";
      msg.hidden = true;

      const res = await fetch(`${apiBase}/api/v1/sites/claim`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ subdomain }),
      });
      const data = await readJson<{ error?: string }>(res).catch(() => ({}) as { error?: string });
      if (!res.ok) {
        if (data.error === "already_has_site") {
          window.location.href = "/dashboard";
          return;
        }
        msg.hidden = false;
        if (data.error === "subdomain_not_allowed") {
          msg.textContent = "That name isn't allowed under our usage policy.";
        } else if (data.error === "moderation_unavailable") {
          msg.textContent = "Couldn't verify that name right now. Try again.";
        } else if (data.error === "taken") {
          msg.textContent = "That name is taken.";
        } else if (data.error === "signups_closed") {
          msg.textContent = formatCapacityLine(capacityState ?? {});
        } else {
          msg.textContent = data.error || "Could not reserve.";
        }
        msg.className = "status status--error";
        continueBtn.disabled = false;
        updateContinueLabel();
        return;
      }
      sessionStorage.removeItem(PENDING_SUB_KEY);
      sessionStorage.setItem("isin_site", subdomain);
      window.location.href = "/dashboard";
    });
  </script>
</Layout>

---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import { ROOT_DOMAIN } from "../siteDomain";
---
<Layout title="Home">
    <h1><span class="title-wildcard">*.&nbsp;</span>{ROOT_DOMAIN}</h1>
    <p class="lede">
      Your own spot on the NZ internet: <code>you.{ROOT_DOMAIN}</code> with a simple
      profile page, short links, and email that forwards to your inbox.
    </p>
    <p>
      You choose where links go, how the page looks, and who gets mail sent to your
      name. We keep the platform small so it stays easy to run.
    </p>
    <p>
      Small on purpose, so we can keep operating it for the long term.
    </p>
    <hr>
    <footer>
      <p class="muted">
        We open sign-ups in cohorts so we don't outgrow what we can operate reliably.
        New places open as each cohort fills.
      </p>
      <ul>
        <li><a href="/claim">Reserve a subdomain</a></li>
      </ul>
    </footer>
</Layout>

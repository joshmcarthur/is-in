---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
---
<Layout title="Web forwarding">
  <a class="back-link" href="/dashboard">‹ Dashboard</a>
  <div class="stack">
    <h2 class="h2 title">Web forwarding</h2>
    <p class="muted">
      Visitors to <code id="hostpreview"></code> are sent to your chosen URL.
    </p>
    <form id="form" class="stack">
      <label for="web">Web forward URL</label>
      <input id="web" name="web" type="url" placeholder="https://example.com" />
      <button type="submit" class="btn btn-primary">Save</button>
    </form>
    <p id="msg" class="status" role="status" aria-live="polite"></p>
  </div>
  <script>
    import { apiBase } from "../client/apiBase";
    import { readJson, requiredElement } from "../client/dom";
    import {
      fetchPlatformStatus,
      webConfigUnavailableCopy,
    } from "../client/platformStatus";
    import { requireSessionAndSite } from "../client/requireSessionAndSite";
    import { ROOT_DOMAIN } from "../siteDomain";

    const form = requiredElement<HTMLFormElement>("form");
    const msg = requiredElement("msg");
    const hostpreview = requiredElement("hostpreview");
    const web = requiredElement<HTMLInputElement>("web");

    async function load() {
      try {
        const status = await fetchPlatformStatus(apiBase);
        const copy = webConfigUnavailableCopy(status);
        if (copy) {
          msg.textContent = copy;
          msg.className = "status";
          web.disabled = true;
          form.querySelector("button")?.setAttribute("disabled", "true");
          return;
        }
        const { site } = await requireSessionAndSite();
        hostpreview.textContent = `${site.subdomain}.${ROOT_DOMAIN}`;
        web.value = site.webForwards?.["*"]?.url || "";
      } catch {
        return;
      }
    }

    load();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      msg.textContent = "Saving…";
      msg.className = "status";
      const sitesRes = await fetch(`${apiBase}/api/v1/sites/me`, { credentials: "include" });
      const body = await readJson<{ sites?: Array<{ subdomain: string }> }>(sitesRes);
      if (!sitesRes.ok || !body.sites?.length) {
        msg.textContent = "No site on your account.";
        msg.className = "status status--error";
        return;
      }
      const sub = body.sites[0].subdomain;
      const webVal = web.value.trim();
      const res = await fetch(`${apiBase}/api/v1/sites/${encodeURIComponent(sub)}/forwarding`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({
          webForwardUrl: webVal || null,
        }),
      });
      const out = await readJson<{ error?: string }>(res).catch(() => ({}) as { error?: string });
      if (!res.ok) {
        if (out.error === "web_config_disabled") {
          msg.textContent = "Web changes are temporarily unavailable.";
        } else {
          msg.textContent = out.error || "Save failed.";
        }
        msg.className = "status status--error";
        return;
      }
      msg.textContent = "Saved.";
      msg.className = "status status--ok";
    });
  </script>
</Layout>

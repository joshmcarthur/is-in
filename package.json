{
  "name": "is-in.nz",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "typecheck": "pnpm -r run typecheck",
    "dev:public-site": "pnpm --filter public-site dev",
    "dev:email-inbound": "pnpm --filter email-inbound dev",
    "dev:management": "pnpm --filter management dev",
    "dev:management:pages": "pnpm --filter management dev:pages",
    "build:management": "pnpm --filter management build",
    "deploy:management": "bash scripts/deploy-management.sh production",
    "deploy:management:staging": "bash scripts/deploy-management.sh staging"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/vitest-pool-workers": "^0.16.10",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "devalue": ">=5.8.1",
      "typescript": ">=6.0.3 <7",
      "vite@7": "7.3.6",
      "undici": ">=7.29.0",
      "ws": ">=8.21.0",
      "js-yaml": ">=4.3.2 <5",
      "fast-uri": ">=3.1.6",
      "sharp": ">=0.35.4",
      "nanoid": ">=3.3.18 <4",
      "postcss": ">=8.5.18",
      "svgo": ">=4.1.0",
      "smol-toml": ">=1.7.1"
    }
  }
}
